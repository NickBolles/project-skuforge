# Explicitly opt into credential-free local auth. Mock auth is rejected in production.
AUTH_MODE=mock

# Required when AUTH_MODE=shopify. These drive OAuth, session tokens, and webhook HMAC verification.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public app URL in production. Local mock mode uses the default below.
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,write_products

# Production uses this with prisma/schema.postgres.prisma. SQLite dev uses prisma/dev.sqlite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/skuforge?schema=public

# Required before enabling Phase 10 cron endpoints. Any non-empty local development value is sufficient.
CRON_SECRET=replace-with-a-long-random-secret

# Mock billing selection. Allowed values: free, pro, premium.
MOCK_PLAN=free

# Use Shopify test charges on a development store. Keep false for production billing.
BILLING_TEST=false

# Optional Shopify custom-domain support retained from the official template.
SHOP_CUSTOM_DOMAIN=
