# Copy to .env only on the VPS, fill values through the server secret workflow, then chmod 600 .env.
# Do not commit the resulting .env file.

# Docker Compose-owned Postgres credentials. Use a unique, high-entropy password.
# URL-encode that password in DATABASE_URL (for example, @ becomes %40).
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_URL=postgresql://skuforge:replace-with-the-url-encoded-postgres-password@db:5432/skuforge?schema=public

# Existing external Traefik Docker network and its configured certificate resolver name.
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
SKUFORGE_HOSTNAME=skuforge.nickbolles.com

# Shopify production application configuration.
NODE_ENV=production
AUTH_MODE=shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://skuforge.nickbolles.com
SCOPES=read_products,write_products
CRON_SECRET=replace-with-a-long-random-cron-secret
BILLING_TEST=false
SHOP_CUSTOM_DOMAIN=
